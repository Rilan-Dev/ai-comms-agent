# Server-side database connection. Never expose this through VITE_* variables.
DATABASE_URL=

# Required to encrypt provider credentials before storing them.
# Supply a securely generated key using the format expected by the credential-encryption implementation.
CREDENTIALS_MASTER_KEY=

# Google Gmail OAuth. Register the callback URL for the deployed environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Zoho Mail OAuth. Register the callback URL for the deployed environment.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=

# WhatsApp Business configuration will be added with the WhatsApp server integration slice.
