{
  "name": "@ai-comms-agent/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Background worker — RabbitMQ consumers for email sync, agent execution, etc.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist .turbo",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@ai-comms-agent/clara-core": "workspace:*",
    "@ai-comms-agent/db": "workspace:*",
    "@ai-comms-agent/shared": "workspace:*",
    "amqplib": "^2.2.0",
    "@ai-comms-agent/email-agent-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
