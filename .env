# Environment variables for local development
# Copy to .env.local and fill in. NEVER commit .env files.
# Per docs/architecture/DEPLOYMENT.md §2 and SECURITY.md §6.

# ---- Application ----
NODE_ENV=development

# ---- Supabase / PostgreSQL (local Docker) ----
# Phase 2: local Postgres via Docker Compose. Phase 4: production Supabase.
SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=local-dev-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-dev-anon-key
# SERVICE_ROLE key is SERVER-ONLY — never expose to browser
SUPABASE_SERVICE_ROLE_KEY=local-dev-service-role-key

# ---- Redis (local Docker) ----
REDIS_URL=redis://platform-redis:6379

# ---- RabbitMQ (local Docker) ----
RABBITMQ_URL=amqp://admin:rmq_admin_K7x9mP2qR5vY8wE4zL1nM3bV6cX9pQ2rT7yU0iO5aS8dF1gH4jK6lZ3@platform-rabbitmq:5672

# ---- Qdrant (local Docker) ----
QDRANT_URL=http://platform-qdrant:6333

# ---- Credentials Master Key (envelope encryption) ----
# Generate with: openssl rand -base64 32
# NEVER commit this. Server-only.
CREDENTIALS_MASTER_KEY=local-dev-master-key-generate-a-real-one

# ---- Session Signing Key ----
# Generate with: openssl rand -base64 32
SESSION_SIGNING_KEY=local-dev-session-key-generate-a-real-one

# ---- OAuth Clients (register in Phase 6/8) ----
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# ZOHO_OAUTH_CLIENT_ID=
# ZOHO_OAUTH_CLIENT_SECRET=

# ---- AI Providers (register in Phase 11) ----
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# SARVAM_API_KEY=
# ELEVENLABS_API_KEY=

# ---- WhatsApp / Meta (register in Phase 13) ----
# WHATSAPP_APP_SECRET=
# WHATSAPP_SYSTEM_USER_TOKEN=
