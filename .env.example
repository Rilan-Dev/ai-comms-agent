# External-service environment template for local development and Vercel.
# Copy to .env.local for local web development. Never commit real credentials.
# The application does NOT start PostgreSQL, Redis, RabbitMQ, or Qdrant automatically.

NODE_ENV=development

# ---- External PostgreSQL / Supabase-compatible PostgreSQL ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ---- External Redis ----
REDIS_URL=rediss://:PASSWORD@HOST:PORT

# ---- External RabbitMQ / CloudAMQP ----
RABBITMQ_URL=amqps://USER:PASSWORD@HOST/VHOST

# ---- External Qdrant / Qdrant Cloud ----
QDRANT_URL=https://YOUR-CLUSTER.qdrant.io
QDRANT_API_KEY=replace-with-qdrant-api-key

# ---- Application secrets ----
CREDENTIALS_MASTER_KEY=replace-with-a-random-32-byte-key
SESSION_SIGNING_KEY=replace-with-a-random-32-byte-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- OAuth clients (enabled in later roadmap phases) ----
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/gmail/callback
# ZOHO_OAUTH_CLIENT_ID=
# ZOHO_OAUTH_CLIENT_SECRET=

# ---- Clara agent execution ----
# CLARA_KB_ID=tenant-knowledge-base-id

# ---- AI providers (enabled in later roadmap phases) ----
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# SARVAM_API_KEY=
# ELEVENLABS_API_KEY=

# ---- WhatsApp / Meta (enabled in later roadmap phases) ----
