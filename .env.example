# Environment variables for local development
# Copy to .env.local and fill in. NEVER commit .env files.
# Per docs/architecture/DEPLOYMENT.md §2 and SECURITY.md §6.

# ---- Application ----
NODE_ENV=development

# ---- PostgreSQL ----
# Any PostgreSQL 15+ deployment is supported (self-hosted or managed).
DATABASE_URL=postgresql://aca:aca_local_dev@localhost:5432/aca
# Optional dedicated migration/session connection.
DIRECT_URL=postgresql://aca:aca_local_dev@localhost:5432/aca

# ---- Redis (local Docker) ----
REDIS_URL=redis://localhost:6379

# ---- RabbitMQ (local Docker) ----
RABBITMQ_URL=amqp://aca:aca_local_dev@localhost:5672

# ---- Qdrant (local Docker) ----
QDRANT_URL=http://localhost:6333

# ---- Credentials Master Key (envelope encryption) ----
# Generate with: openssl rand -base64 32
# NEVER commit this. Server-only.
CREDENTIALS_MASTER_KEY=replace-with-a-random-32-byte-key

# ---- Application URL ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Session Signing Key ----
# Generate with: openssl rand -base64 32
SESSION_SIGNING_KEY=local-dev-session-key-generate-a-real-one

# ---- OAuth Clients (register in Phase 6/8) ----
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# ZOHO_OAUTH_CLIENT_ID=
# ZOHO_OAUTH_CLIENT_SECRET=

# ---- AI Providers (register in Phase 11) ----
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# SARVAM_API_KEY=
# ELEVENLABS_API_KEY=

# ---- WhatsApp / Meta (register in Phase 13) ----
# WHATSAPP_APP_SECRET=
# WHATSAPP_SYSTEM_USER_TOKEN=
