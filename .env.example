# External-service environment template for local development and Vercel.
# Copy to .env.local for local web development. Never commit real credentials.
# The application does NOT start PostgreSQL, Redis, RabbitMQ, or Qdrant automatically.

NODE_ENV=development

# ---- External PostgreSQL / Supabase-compatible PostgreSQL ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ---- External Redis ----
REDIS_URL=rediss://:PASSWORD@HOST:PORT

# ---- External RabbitMQ / CloudAMQP ----
RABBITMQ_URL=amqps://USER:PASSWORD@HOST/VHOST

# ---- External Qdrant / Qdrant Cloud ----
QDRANT_URL=https://YOUR-CLUSTER.qdrant.io
QDRANT_API_KEY=replace-with-qdrant-api-key

 # ---- Application-owned authentication ----
# Authentication uses PostgreSQL credentials + opaque server sessions. No hosted auth provider is required.
APP_ORIGIN=http://localhost:3000
# Generate a random >=32-character one-time bootstrap secret; remove it after initialization.
AUTH_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token

# ---- Application secrets ----
CREDENTIALS_MASTER_KEY=replace-with-a-random-32-byte-key
SESSION_SIGNING_KEY=replace-with-a-random-32-byte-key

# OAuth client IDs/secrets are managed in authenticated platform Settings UI. Callback URLs are derived from the active request host.
# CREDENTIALS_MASTER_KEY remains a server-only infrastructure key used to encrypt stored provider secrets.

# ---- Clara agent execution ----
# CLARA_KB_ID=tenant-knowledge-base-id

# ---- AI providers (enabled in later roadmap phases) ----
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# SARVAM_API_KEY=
# ELEVENLABS_API_KEY=

# ---- WhatsApp / Meta (enabled in later roadmap phases) ----
# WHATSAPP_APP_SECRET=
# WHATSAPP_SYSTEM_USER_TOKEN=
