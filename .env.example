# ai-comms-agent — Complete Environment Configuration
# Copy this file to .env (local dev) or set these on Vercel Project Settings → Environment Variables.
# Lines starting with # are comments. Replace ALL placeholder values with your real credentials.

# ============================================================================
# 1. NODE ENVIRONMENT
# ============================================================================
NODE_ENV=production

# ============================================================================
# 2. POSTGRESQL DATABASE (Prisma Postgres or self-hosted PostgreSQL 15+)
# ============================================================================
# The primary connection string. Prisma Postgres Data Proxy format: postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Direct connection (same as DATABASE_URL for Prisma Postgres)
DIRECT_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ============================================================================
# 3. REDIS (Redis Cloud or self-hosted Redis 7+)
# ============================================================================
REDIS_URL=redis://:PASSWORD@HOST:PORT

# ============================================================================
# 4. RABBITMQ (CloudAMQP or self-hosted RabbitMQ 3.13+)
# ============================================================================
RABBITMQ_URL=amqps://USER:PASSWORD@HOST/VHOST

# ============================================================================
# 5. QDRANT (Qdrant Cloud or self-hosted Qdrant 1.12+)
# ============================================================================
QDRANT_URL=https://YOUR-CLUSTER.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ============================================================================
# 6. APPLICATION SECRETS (generate with: openssl rand -base64 32)
# ============================================================================
# Platform-level encryption key for credential storage (OAuth tokens, IMAP passwords, etc.)
CREDENTIALS_MASTER_KEY=replace-with-a-random-32-byte-key
# Session signing key for HttpOnly cookies
SESSION_SIGNING_KEY=replace-with-a-random-32-byte-key
# One-time bootstrap token for first admin account (remove after initialization)
AUTH_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token

# ============================================================================
# 7. APPLICATION ORIGIN
# ============================================================================
# For local dev: http://localhost:3000
# For Vercel: https://your-project.vercel.app (or custom domain)
APP_ORIGIN=https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# ============================================================================
# 8. AI PROVIDERS (set at least one; env vars are fallbacks — DB-stored
#    configs in ai_provider_configs table take priority per-organization)
# ============================================================================
# Default AI provider: openai, gemini, or sarvam
AI_PROVIDER=sarvam

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_DEFAULT_VOICE=alloy

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Sarvam AI (https://indus.sarvam.ai/key-management)
SARVAM_API_KEY=sk_your-sarvam-key
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=sk_your-elevenlabs-key

# Realtime voice provider: openai, sarvam, or elevenlabs
REALTIME_VOICE_PROVIDER=sarvam

# Knowledge base ID (optional — defaults to "default"; RAG features are skipped when not configured)
CLARA_KB_ID=default

# ============================================================================
# 9. GMAIL OAUTH (Google Cloud Console → OAuth consent screen → credentials)
#    These are also configurable per-organization via Settings UI (stored in DB).
# ============================================================================
GMAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
# Register these redirect URIs in Google Cloud Console:
# http://localhost:3000/api/oauth/gmail/callback (local)
# https://your-project.vercel.app/api/oauth/gmail/callback (production)

# Gmail push sync (optional until Google Cloud Pub/Sub is configured).
# Use the same Google Cloud project that owns the Gmail OAuth client.
# The push endpoint must be publicly reachable over HTTPS.
# GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-changes
# GMAIL_PUBSUB_PUSH_AUDIENCE=https://your-project.vercel.app/api/webhooks/gmail
# GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT=gmail-pubsub-push@your-gcp-project.iam.gserviceaccount.com
# Create/configure these with: bash scripts/setup-gmail-pubsub.sh
# Keep sync_webhook capability disabled until live delivery and reconciliation are verified.

# ============================================================================
# 10. ZOHO MAIL OAUTH (Zoho API Console → Server-based Applications)
#     These are also configurable per-organization via Settings UI (stored in DB).
# ============================================================================
ZOHO_OAUTH_CLIENT_ID=1000.YOUR_CLIENT_ID
ZOHO_OAUTH_CLIENT_SECRET=your-zoho-client-secret
# Register these redirect URIs in Zoho API Console:
# http://localhost:3000/api/oauth/zoho/callback (local)
# https://your-project.vercel.app/api/oauth/zoho/callback (production)

# ============================================================================
# 11. MICROSOFT 365 / OUTLOOK OAUTH (Microsoft Entra admin center → App registrations)
# Microsoft OAuth application clients and optional webhook URLs are configured
# at runtime under Settings -> Mail OAuth clients -> Microsoft Graph.
# They are stored per organization in encrypted platform configuration;
# do NOT set MICROSOFT_OAUTH_* or MICROSOFT_GRAPH_NOTIFICATION_URL in .env.
# Only the generic host encryption root CREDENTIALS_MASTER_KEY stays server-side.
# Register https://your-public-domain.example/api/oauth/microsoft/callback
# with your Microsoft Entra application, granting delegated Mail.Read and
# offline_access. Changes in Platform Settings do not require a rebuild.

# ============================================================================
# 12. WHATSAPP BUSINESS (Meta Business Suite → WhatsApp Manager)
# ============================================================================
WHATSAPP_APP_SECRET=your-webhook-verification-secret
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_SYSTEM_USER_TOKEN=your-system-user-access-token
WHATSAPP_GRAPH_API_VERSION=v21.0

# ============================================================================
# 12. DEV IDENTITY (local development only — keep "false" or unset in production)
# ============================================================================
# When true AND NODE_ENV is not "production", enables the dev identity stub
# (x-dev-user-id header) for local testing. In production the auth adapter is
# always the PostgreSQL-backed LocalIdentityAdapter, but leaving this "true"
# with NODE_ENV=production still lets ensureDevSeed() write a dev user and
# dev organization into the database — keep it false/unset for deployments.
ACA_ENABLE_DEV_IDENTITY=true

# ============================================================================
# 13. EMAIL ATTACHMENT STORAGE
# ============================================================================
# Local filesystem path for email attachment storage.
# Replace with an absolute path that exists on your machine. Use a path
# inside the repo for self-contained setups (e.g., ./data/attachments — the
# app will create it if missing), or an absolute path like /var/ai-comms/attachments.
ATTACHMENT_STORAGE_ROOT=./data/attachments
