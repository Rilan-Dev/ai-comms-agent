{
  "name": "ai-comms-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-channel AI communications agent — monorepo root",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "dev:web": "pnpm --filter @ai-comms-agent/web dev",
    "dev:worker": "pnpm --filter @ai-comms-agent/worker dev",
    "build:web": "pnpm --filter @ai-comms-agent/web build",
    "build:worker": "pnpm --filter @ai-comms-agent/worker build",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
