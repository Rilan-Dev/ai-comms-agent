# Self-hosted Docker runtime template.
# Copy this file to .env.docker and replace EVERY external service endpoint/credential.
# Do not commit .env.docker.

NODE_ENV=production

# The manual Compose stack does NOT start PostgreSQL, Redis, RabbitMQ, or Qdrant.
# These services are external to the application Compose project. For the
# common local setup where they are Docker containers publishing ports on the
# host, use host.docker.internal so BOTH web/worker containers and host-side
# diagnostics can reach the same services. Do not use Compose-only names such
# as postgres-db/platform-redis/platform-rabbitmq/platform-qdrant here.
DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:65432/ai_comms_agent?sslmode=disable
DIRECT_URL=postgresql://USER:PASSWORD@host.docker.internal:65432/ai_comms_agent?sslmode=disable
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

REDIS_URL=redis://:PASSWORD@host.docker.internal:6379
RABBITMQ_URL=amqp://USER:PASSWORD@host.docker.internal:5672/VHOST
QDRANT_URL=http://host.docker.internal:6333
QDRANT_API_KEY=replace-with-qdrant-api-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Replace before exposing the stack beyond a trusted network.
CREDENTIALS_MASTER_KEY=replace-with-a-random-32-byte-key
SESSION_SIGNING_KEY=replace-with-a-random-32-byte-key
