# Self-hosted Docker runtime template.
# Copy this file to .env.docker and replace EVERY external service endpoint/credential.
# Do not commit .env.docker.

NODE_ENV=production

# The manual Compose stack does NOT start PostgreSQL, Redis, RabbitMQ, or Qdrant.
# These hosts must be reachable from the application containers.
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/ai_comms_agent?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/ai_comms_agent?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379
RABBITMQ_URL=amqps://USER:PASSWORD@RABBITMQ_HOST:5671/VHOST
QDRANT_URL=https://QDRANT_HOST
QDRANT_API_KEY=replace-with-qdrant-api-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Replace before exposing the stack beyond a trusted network.
CREDENTIALS_MASTER_KEY=replace-with-a-random-32-byte-key
SESSION_SIGNING_KEY=replace-with-a-random-32-byte-key
