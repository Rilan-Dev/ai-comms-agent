# Self-hosted Docker runtime defaults.
# Copy this file to .env.docker on the host. Do not commit the copy.
NODE_ENV=production
DATABASE_URL=postgresql://aca:aca_local_dev@postgres-db:5432/aca
DIRECT_URL=postgresql://aca:aca_local_dev@postgres-db:5432/aca
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://aca:aca_local_dev@rabbitmq:5672
QDRANT_URL=http://qdrant:6333
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Replace before exposing the stack beyond a trusted network.
CREDENTIALS_MASTER_KEY=replace-with-a-random-32-byte-key
SESSION_SIGNING_KEY=replace-with-a-random-32-byte-key
